{
  "manifest_version": 3,
  "name": "X Image Downloader",
  "version": "1.4.0",
  "description": "X(Twitter)の画像・動画を原寸で保存します。保存先のフォルダ名・ファイル名はテンプレートで自由に設定できます。",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://pbs.twimg.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "X Image Downloader の設定"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "x-image-downloader@kako774",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
